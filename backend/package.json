{
  "name": "@bunker/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/backend/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bunker/contracts": "workspace:*",
    "@bunker/game-engine": "workspace:*",
    "cors": "catalog:",
    "express": "catalog:",
    "socket.io": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "socket.io-client": "catalog:",
    "supertest": "catalog:",
    "@types/supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
