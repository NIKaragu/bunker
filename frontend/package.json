{
  "name": "@bunker/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev",
    "dev:2": "NEXT_DIST_DIR=.next-3001 next dev -p 3001",
    "prebuild": "tsc -p tsconfig.build.json",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bunker/contracts": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "4.8.3",
    "zustand": "5.0.15",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "jsdom": "27.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.48.1",
    "vitest": "5.0.0"
  }
}
